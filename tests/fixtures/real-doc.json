            },
            {
              "startIndex": 63,
              "endIndex": 81,
              "textRun": {
                "content": "Rooted in Cambodia",
                "textStyle": {
                  "bold": true
                }
              }
            },
            {
              "startIndex": 81,
              "endIndex": 319,
              "textRun": {
                "content": " is a transformative program for Cambodian Americans, ages 21 - 26, offering a unique opportunity to connect with Cambodia, the culture and language, and their own family and family history. This immersive and experiential program allows ",
                "textStyle": {}
              }
            },
            {
              "startIndex": 319,
              "endIndex": 352,
              "textRun": {
                "content": "first time travelers to Cambodia ",
                "textStyle": {
                  "italic": true
                }
              }
            },
            {
              "startIndex": 352,
              "endIndex": 556,
              "textRun": {
                "content": "to engage within a safe and supportive cohort environment led by Cambodian Americans who have lived and worked in Cambodia.\u000bRooted in Cambodia cohorts are intentionally small with up to six participants.\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {
